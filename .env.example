# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
# Use a local PostgreSQL 15+ database. The same schema works on managed
# Postgres (Neon, Supabase, RDS, Cloud SQL, etc.).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hms?schema=public"

# Required: generate with `openssl rand -base64 48` and paste the result.
# The app refuses to start while this is shorter than 32 characters.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Docker Compose only (docker compose reads these to provision PostgreSQL)
# ---------------------------------------------------------------------------
# Compose embeds this password in a connection URL, so use URL-safe characters.
# Required: generate one with `openssl rand -hex 32`.
POSTGRES_USER="hms"
POSTGRES_PASSWORD=""
POSTGRES_DB="hms"
APP_PORT="3000"
