# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
# Use a local PostgreSQL 15+ database. The same schema works on managed
# Postgres (Neon, Supabase, RDS, Cloud SQL, etc.).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hms?schema=public"

# Required: generate with `openssl rand -base64 48` and paste the result.
# The app refuses to start while this is shorter than 32 characters.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
